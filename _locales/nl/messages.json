  "infoIntro": {
    "message": "MirrorTab spiegelt DOM-interacties: klikken, invoer, toetsaanslagen, focus, hover en scrollen, inclusief iframes, in realtime van een <strong>bron</strong>tabblad naar een of meer <strong>doel</strong>tabbladen. Perfect voor demo's, tests en livepresentaties."
  },
  "infoStep1": {
    "message": "Voer een <strong>bron-URL</strong> en minstens één <strong>doel-URL</strong> in."
  },
  "infoStep2": {
    "message": "Klik op <strong>Sessie starten</strong>, de tabbladen openen automatisch."
  },
  "infoStep3": {
    "message": "Werk in het <strong class=\"kd-text-danger\">BRON</strong>-tabblad, acties worden live gespiegeld naar elk <strong class=\"kd-text-accent\">DOEL</strong>-tabblad."
  },
  "infoStep4": {
    "message": "Gebruik <strong>Pauzeren / Hervatten</strong> of <strong>Stoppen</strong> om de sessie te besturen."
  },
  "infoStep5": {
    "message": "Download het gebeurtenissenlog op elk moment als <strong>JSON</strong> of <strong>Tekst</strong>."
  },
