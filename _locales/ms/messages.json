  },
  "infoStep3": {
    "message": "Berinteraksi dalam tab <strong class=\"kd-text-danger\">SUMBER</strong>, tindakan dicerminkan secara langsung ke setiap tab <strong class=\"kd-text-accent\">SASARAN</strong>."
  },
  "infoStep4": {
    "message": "Gunakan <strong>Jeda / Sambung</strong> atau <strong>Henti</strong> untuk mengawal sesi."
  },
  "infoStep5": {
