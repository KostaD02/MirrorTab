  "infoIntro": {
    "message": "MirrorTab mencerminkan interaksi DOM: klik, input, ketukan kekunci, fokus, hover dan penatalan, termasuk iframe, dari tab <strong>sumber</strong> ke satu atau lebih tab <strong>sasaran</strong> dalam masa nyata. Sesuai untuk demo, pengujian dan pembentangan langsung."
  },
  "infoStep1": {
    "message": "Masukkan <strong>URL sumber</strong> dan sekurang-kurangnya satu <strong>URL sasaran</strong>."
  },
  "infoStep2": {
