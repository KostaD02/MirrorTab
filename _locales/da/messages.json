  "infoIntro": {
    "message": "MirrorTab spejler DOM-interaktioner: klik, input, tastetryk, fokus, hover og scroll, også i iframes, fra en <strong>kildefane</strong> til en eller flere <strong>målfaner</strong> i realtid. Perfekt til demoer, test og livepræsentationer."
  },
  "infoStep1": {
    "message": "Indtast en <strong>kilde-URL</strong> og mindst én <strong>mål-URL</strong>."
  },
  "infoStep2": {
    "message": "Klik på <strong>Start session</strong>, fanerne åbnes automatisk."
  },
  "infoStep3": {
    "message": "Arbejd i fanen <strong class=\"kd-text-danger\">KILDE</strong>, handlingerne spejles live i hver <strong class=\"kd-text-accent\">MÅL</strong>-fane."
  },
  "infoStep4": {
    "message": "Brug <strong>Pause / Fortsæt</strong> eller <strong>Stop</strong> til at styre sessionen."
  },
  "infoStep5": {
    "message": "Download hændelsesloggen når som helst som <strong>JSON</strong> eller <strong>Tekst</strong>."
