  "infoIntro": {
    "message": "MirrorTab spiegelt DOM-Interaktionen: Klicks, Eingaben, Tastenanschläge, Fokus, Hover und Scrollen, Iframes eingeschlossen, in Echtzeit von einem <strong>Quell</strong>-Tab auf einen oder mehrere <strong>Ziel</strong>-Tabs. Ideal für Demos, Tests und Live-Präsentationen."
  },
  "infoStep1": {
    "message": "Eine <strong>Quell-URL</strong> und mindestens eine <strong>Ziel-URL</strong> eingeben."
  },
  "infoStep2": {
    "message": "Auf <strong>Sitzung starten</strong> klicken, die Tabs öffnen sich automatisch."
  },
  "infoStep3": {
    "message": "Im <strong class=\"kd-text-danger\">QUELLE</strong>-Tab arbeiten, die Aktionen werden live auf jeden <strong class=\"kd-text-accent\">ZIEL</strong>-Tab gespiegelt."
  },
  "infoStep4": {
    "message": "Mit <strong>Pause / Fortsetzen</strong> oder <strong>Stopp</strong> die Sitzung steuern."
  },
  "infoStep5": {
    "message": "Das Ereignisprotokoll jederzeit als <strong>JSON</strong> oder <strong>Text</strong> herunterladen."
  },
