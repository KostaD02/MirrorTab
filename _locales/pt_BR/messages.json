  "infoIntro": {
    "message": "O MirrorTab espelha interações do DOM: cliques, entradas, teclas, foco, hover e rolagem, iframes incluídos, de uma aba de <strong>origem</strong> para uma ou mais abas de <strong>destino</strong> em tempo real. Perfeito para demos, testes e apresentações ao vivo."
  },
  "infoStep1": {
    "message": "Informe uma <strong>URL de origem</strong> e pelo menos uma <strong>URL de destino</strong>."
  },
  "infoStep2": {
    "message": "Clique em <strong>Iniciar sessão</strong>, as abas abrem automaticamente."
  },
  "infoStep3": {
    "message": "Interaja com a aba <strong class=\"kd-text-danger\">ORIGEM</strong>, as ações são espelhadas ao vivo em cada aba <strong class=\"kd-text-accent\">DESTINO</strong>."
  },
  "infoStep4": {
    "message": "Use <strong>Pausar / Retomar</strong> ou <strong>Parar</strong> para controlar a sessão."
  },
  "infoStep5": {
    "message": "Baixe o registro de eventos como <strong>JSON</strong> ou <strong>Texto</strong> a qualquer momento."
  },
