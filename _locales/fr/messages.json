  "infoIntro": {
    "message": "MirrorTab réplique les interactions DOM : clics, saisies, frappes clavier, focus, survol et défilement, iframes compris, d'un onglet <strong>source</strong> vers un ou plusieurs onglets <strong>cibles</strong> en temps réel. Idéal pour les démos, les tests et les présentations en direct."
  },
  "infoStep1": {
    "message": "Saisissez une <strong>URL source</strong> et au moins une <strong>URL cible</strong>."
  },
  "infoStep2": {
    "message": "Cliquez sur <strong>Démarrer la session</strong>, les onglets s'ouvrent automatiquement."
  },
  "infoStep3": {
    "message": "Interagissez avec l'onglet <strong class=\"kd-text-danger\">SOURCE</strong>, les actions sont répliquées en direct sur chaque onglet <strong class=\"kd-text-accent\">CIBLE</strong>."
  },
  "infoStep4": {
    "message": "Utilisez <strong>Pause / Reprendre</strong> ou <strong>Arrêter</strong> pour contrôler la session."
  },
  "infoStep5": {
    "message": "Téléchargez le journal des événements en <strong>JSON</strong> ou en <strong>Texte</strong> à tout moment."
  },
