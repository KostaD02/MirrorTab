  "infoIntro": {
    "message": "MirrorTab odzwierciedla interakcje z DOM: kliknięcia, wpisywanie, naciśnięcia klawiszy, fokus, najechanie i przewijanie, łącznie z iframe, z karty <strong>źródłowej</strong> na jedną lub więcej kart <strong>docelowych</strong> w czasie rzeczywistym. Idealne do demonstracji, testów i prezentacji na żywo."
  },
  "infoStep1": {
    "message": "Wpisz <strong>adres URL źródła</strong> i co najmniej jeden <strong>adres URL celu</strong>."
  },
  "infoStep2": {
    "message": "Kliknij <strong>Rozpocznij sesję</strong>, karty otworzą się automatycznie."
  },
  "infoStep3": {
    "message": "Pracuj na karcie <strong class=\"kd-text-danger\">ŹRÓDŁO</strong>, działania są na żywo odzwierciedlane na każdej karcie <strong class=\"kd-text-accent\">CEL</strong>."
  },
  "infoStep4": {
    "message": "Użyj <strong>Wstrzymaj / Wznów</strong> lub <strong>Zatrzymaj</strong>, aby sterować sesją."
  },
  "infoStep5": {
    "message": "Pobierz dziennik zdarzeń jako <strong>JSON</strong> lub <strong>Tekst</strong> w dowolnej chwili."
  },
