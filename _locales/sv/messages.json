  "infoIntro": {
    "message": "MirrorTab speglar DOM-interaktioner: klick, inmatning, tangenttryck, fokus, hover och skrollning, även i iframes, från en <strong>källflik</strong> till en eller flera <strong>målflikar</strong> i realtid. Perfekt för demos, testning och livepresentationer."
  },
  "infoStep1": {
    "message": "Ange en <strong>käll-URL</strong> och minst en <strong>mål-URL</strong>."
  },
  "infoStep2": {
    "message": "Klicka på <strong>Starta session</strong>, flikarna öppnas automatiskt."
  },
  "infoStep3": {
    "message": "Arbeta i fliken <strong class=\"kd-text-danger\">KÄLLA</strong>, åtgärderna speglas live i varje <strong class=\"kd-text-accent\">MÅL</strong>-flik."
  },
  "infoStep4": {
    "message": "Använd <strong>Pausa / Återuppta</strong> eller <strong>Stoppa</strong> för att styra sessionen."
  },
  "infoStep5": {
    "message": "Ladda när som helst ned händelseloggen som <strong>JSON</strong> eller <strong>Text</strong>."
  },
