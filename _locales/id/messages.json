  "infoIntro": {
    "message": "MirrorTab mencerminkan interaksi DOM: klik, input, penekanan tombol, fokus, hover, dan pengguliran, termasuk iframe, dari tab <strong>sumber</strong> ke satu atau lebih tab <strong>target</strong> secara real-time. Cocok untuk demo, pengujian, dan presentasi langsung."
  },
  "infoStep1": {
    "message": "Masukkan <strong>URL sumber</strong> dan minimal satu <strong>URL target</strong>."
  },
  "infoStep2": {
    "message": "Klik <strong>Mulai sesi</strong>, tab akan terbuka otomatis."
  },
  "infoStep3": {
    "message": "Berinteraksilah di tab <strong class=\"kd-text-danger\">SUMBER</strong>, tindakan dicerminkan langsung ke setiap tab <strong class=\"kd-text-accent\">TARGET</strong>."
  },
  "infoStep4": {
    "message": "Gunakan <strong>Jeda / Lanjutkan</strong> atau <strong>Berhenti</strong> untuk mengendalikan sesi."
  },
  "infoStep5": {
