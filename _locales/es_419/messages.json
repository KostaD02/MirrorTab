  "infoIntro": {
    "message": "MirrorTab refleja interacciones del DOM: clics, entradas, pulsaciones de teclas, foco, hover y desplazamiento, iframes incluidos, de una pestaña de <strong>origen</strong> a una o más pestañas de <strong>destino</strong> en tiempo real. Ideal para demos, pruebas y presentaciones en vivo."
  },
  "infoStep1": {
    "message": "Ingresa una <strong>URL de origen</strong> y al menos una <strong>URL de destino</strong>."
  },
  "infoStep2": {
    "message": "Haz clic en <strong>Comenzar sesión</strong>, las pestañas se abren automáticamente."
  },
  "infoStep3": {
    "message": "Interactúa con la pestaña <strong class=\"kd-text-danger\">ORIGEN</strong>, las acciones se reflejan en vivo en cada pestaña <strong class=\"kd-text-accent\">DESTINO</strong>."
  },
  "infoStep4": {
    "message": "Usa <strong>Pausar / Reanudar</strong> o <strong>Detener</strong> para controlar la sesión."
  },
  "infoStep5": {
    "message": "Descarga el registro de eventos como <strong>JSON</strong> o <strong>Texto</strong> en cualquier momento."
  },
