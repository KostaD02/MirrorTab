  "infoIntro": {
    "message": "MirrorTab replica le interazioni DOM: clic, input, pressioni dei tasti, focus, hover e scorrimento, iframe inclusi, da una scheda di <strong>origine</strong> a una o più schede di <strong>destinazione</strong> in tempo reale. Perfetto per demo, test e presentazioni dal vivo."
  },
  "infoStep1": {
    "message": "Inserisci un <strong>URL di origine</strong> e almeno un <strong>URL di destinazione</strong>."
  },
  "infoStep2": {
    "message": "Fai clic su <strong>Avvia sessione</strong>, le schede si aprono automaticamente."
  },
  "infoStep3": {
    "message": "Interagisci con la scheda <strong class=\"kd-text-danger\">ORIGINE</strong>, le azioni vengono replicate dal vivo su ogni scheda <strong class=\"kd-text-accent\">DESTINAZIONE</strong>."
  },
  "infoStep4": {
    "message": "Usa <strong>Pausa / Riprendi</strong> o <strong>Interrompi</strong> per controllare la sessione."
  },
  "infoStep5": {
    "message": "Scarica il log degli eventi come <strong>JSON</strong> o <strong>Testo</strong> in qualsiasi momento."
  },
