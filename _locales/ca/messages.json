  "infoIntro": {
    "message": "MirrorTab reflecteix les interaccions del DOM: clics, entrades, pulsacions de tecla, focus, passar el ratolí i desplaçament, també dins d’iframes, d’una pestanya <strong>d’origen</strong> a una o més pestanyes <strong>de destinació</strong> en temps real. Perfecte per a demostracions, proves i presentacions en directe."
  },
  "infoStep1": {
    "message": "Introdueix un <strong>URL d’origen</strong> i almenys un <strong>URL de destinació</strong>."
  },
  "infoStep2": {
    "message": "Fes clic a <strong>Inicia la sessió</strong>; les pestanyes s’obren automàticament."
  },
  "infoStep3": {
    "message": "Interactua a la pestanya <strong class=\"kd-text-danger\">ORIGEN</strong>; les accions es reflecteixen en directe a cada pestanya <strong class=\"kd-text-accent\">DESTINACIÓ</strong>."
  },
  "infoStep4": {
    "message": "Fes servir <strong>Pausa / Reprèn</strong> o <strong>Atura</strong> per controlar la sessió."
  },
  "infoStep5": {
    "message": "Baixa el registre d’esdeveniments quan vulguis en <strong>JSON</strong> o <strong>Text</strong>."
  },
