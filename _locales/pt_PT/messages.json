  "infoIntro": {
    "message": "O MirrorTab espelha interações do DOM: cliques, entradas, teclas, foco, hover e deslocamento, iframes incluídos, de um separador de <strong>origem</strong> para um ou mais separadores de <strong>destino</strong> em tempo real. Perfeito para demonstrações, testes e apresentações ao vivo."
  },
  "infoStep1": {
    "message": "Introduza um <strong>URL de origem</strong> e pelo menos um <strong>URL de destino</strong>."
  },
  "infoStep2": {
    "message": "Clique em <strong>Iniciar sessão</strong>, os separadores abrem automaticamente."
  },
  "infoStep3": {
    "message": "Interaja com o separador <strong class=\"kd-text-danger\">ORIGEM</strong>, as ações são espelhadas ao vivo em cada separador <strong class=\"kd-text-accent\">DESTINO</strong>."
  },
  "infoStep4": {
    "message": "Use <strong>Pausar / Retomar</strong> ou <strong>Parar</strong> para controlar a sessão."
  },
  "infoStep5": {
    "message": "Transfira o registo de eventos como <strong>JSON</strong> ou <strong>Texto</strong> a qualquer momento."
  },
