  "infoIntro": {
    "message": "MirrorTab speiler DOM-interaksjoner: klikk, inndata, tastetrykk, fokus, hover og rulling, også i iframes, fra en <strong>kildefane</strong> til én eller flere <strong>målfaner</strong> i sanntid. Perfekt for demoer, testing og direktepresentasjoner."
  },
  "infoStep1": {
    "message": "Skriv inn en <strong>kilde-URL</strong> og minst én <strong>mål-URL</strong>."
  },
  "infoStep2": {
    "message": "Klikk på <strong>Start økt</strong>, fanene åpnes automatisk."
  },
  "infoStep3": {
    "message": "Jobb i fanen <strong class=\"kd-text-danger\">KILDE</strong>, handlingene speiles direkte i hver <strong class=\"kd-text-accent\">MÅL</strong>-fane."
  },
  "infoStep4": {
    "message": "Bruk <strong>Pause / Fortsett</strong> eller <strong>Stopp</strong> for å styre økten."
  },
  "infoStep5": {
    "message": "Last ned hendelsesloggen når som helst som <strong>JSON</strong> eller <strong>Tekst</strong>."
  },
